}

@article{di_falco_impact_2013,
	title = {The {Impact} of {Kinship} {Networks} on the {Adoption} of {Risk}-{Mitigating} {Strategies} in {Ethiopia}},
	volume = {43},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {0305750X},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0305750X12002550},
	doi = {10.1016/j.worlddev.2012.10.011},
	abstract = {The adoption of certain farm management practices, such as tree planting and soil and water conservation, can reduce exposure to weather shocks. However, in many countries the adoption of such risk mitigating measures is far from complete. We explore how risk-sharing networks in the form of kinship, characterized by the moral imperative of within-group sharing, aﬀects the adoption of risk mitigating activities in rural Ethiopia. We ﬁnd suggestive evidence that compulsory sharing invites free riding and attenuates incentives for self-protection against weather shocks. We also ﬁnd evidence of the existence of a possible substitution eﬀect between credit and social networks.},
	language = {en},
	urldate = {2026-10-02},
	journal = {World Development},
	author = {Di Falco, Salvatore and Bulte, Erwin},
	month = mar,
	year = {2013},
	pages = {100--110},
}

@article{de_janvry_subjective_2023,
	title = {Subjective {Performance} {Evaluation}, {Influence} {Activities}, and {Bureaucratic} {Work} {Behavior}: {Evidence} from {China}},
	volume = {113},
	issn = {0002-8282},
	shorttitle = {Subjective {Performance} {Evaluation}, {Influence} {Activities}, and {Bureaucratic} {Work} {Behavior}},
	url = {https://pubs.aeaweb.org/doi/10.1257/aer.20211207},
	doi = {10.1257/aer.20211207},
	abstract = {Subjective performance evaluation could induce influence activities: employees might devote too much effort to pleasing their evaluator, relative to working toward the goals of the organization itself. We conduct a randomized field experiment among Chinese local civil servants to study the existence and implications of influence activities. We find that civil servants do engage in evaluator-specific influence to affect evaluation outcomes, partly in the form of reallocating work efforts toward job tasks that are more important and observable to the evaluator. Importantly, we show that introducing uncertainty about the evaluator’s identity discourages evaluator-specific influence activities and improves bureaucratic work performance. (JEL D73, H83, J45, M54, O17, O18, P25)},
	language = {en},
	number = {3},
	urldate = {2026-10-02},
	journal = {American Economic Review},
